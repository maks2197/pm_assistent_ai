# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_BotFather
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook

# YouGile (канбан-доска)
YOUGILE_API_KEY=your_yougile_api_key
YOUGILE_BOARD_ID=your_board_id

# OpenAI (для NLP)
OPENAI_API_KEY=your_openai_key

# Yandex SpeechKit (распознавание речи)
YANDEX_SPEECHKIT_API_KEY=your_speechkit_key

# База данных
DB_USER=pmassistant
DB_PASSWORD=change_me_in_production
DB_NAME=pmassistant

# Секреты
SECRET_KEY=generate_random_string_32_chars

# Окружение
ENV=production
